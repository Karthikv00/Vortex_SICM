# Copy this file to .env when the chosen stack requires environment variables.
# Never commit the real .env file.

APP_NAME=hackathon-project
APP_ENV=development

# Supabase Persistence Configuration (Production)
# If omitted or offline, QueueWise transparently falls back to local persistence.
# SUPABASE_URL=https://<your-project-id>.supabase.co
# SUPABASE_KEY=<your-anon-or-service-role-key>
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
